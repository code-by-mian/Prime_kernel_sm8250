# KernelSU core
CONFIG_KSU=y

# Early boot hooks
CONFIG_KSU_KPROBES_KSUD=n

# Syscall table tampering (experimental)
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y

# Features
CONFIG_KSU_FEATURE_SULOG=y
CONFIG_KSU_FEATURE_ADBROOT=y
CONFIG_KSU_FEATURE_ADBROOT_DEFAULT_ENABLE=n

# Debugging
CONFIG_KSU_DEBUG=n

# Throne tracker threading
CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=n

# Security hooks
CONFIG_KSU_LSM_SECURITY_HOOKS=y

